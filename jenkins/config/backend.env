# Backend application settings, deployed by the Jenkins pipeline.
#
# To add or change a setting: edit this file and commit to main. The next
# pipeline run redeploys the backend with the new values.
#
# Managed by the pipeline (set here = ignored): APP_NAME, NODE_ENV, PORT,
# FRONTEND_URL, DATA_ANALYTICS_URL, NOTIFY_BASE_URL, BROKER_SYNC_ENABLED and
# all DB_* variables. Ask the CI/CD maintainer to change those.
# No secrets in this file: it is in git.

# Days in each entity's reference range.
REFERENCE_DAYS=7

# Subscription marker namespace. Empty in production.
SUBSCRIPTION_TAG=
