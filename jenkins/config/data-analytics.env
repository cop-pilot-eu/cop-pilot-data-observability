# Data-analytics application settings, deployed by the Jenkins pipeline.
#
# To add or change a setting: edit this file and commit to main. The next
# pipeline run redeploys data-analytics with the new values.
#
# Managed by the pipeline (set here = ignored): all POSTGRES_* variables.
# No secrets in this file: it is in git.

# NannyML drift chunking: CHUNK_BY=size uses CHUNK_SIZE rows,
# CHUNK_BY=period uses CHUNK_PERIOD (pandas alias: h, D, W).
CHUNK_BY=period
CHUNK_SIZE=1440
CHUNK_PERIOD=D
