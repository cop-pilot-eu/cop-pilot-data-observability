APP_NAME=backend

FRONTEND_URL=http://localhost:3000
DATA_ANALYTICS_URL=http://localhost:8000
NOTIFY_BASE_URL=http://<notify-host>:<port>
BROKER_SYNC_ENABLED=false
# Empty in prod. Set e.g. `dev` for a second deployment on the same brokers.
SUBSCRIPTION_TAG=
# Days in each entity's reference range. Default 7.
REFERENCE_DAYS=7

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timescaledb
DB_USERNAME=timescaledb
DB_PASSWORD=timescaledb
